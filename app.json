{
  "configVersion": "v3",
  "app": {
    "appId": 1126615,
    "appName": "宽基指数行情",
    "appType": "app",
    "version": {
      "code": 100,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "宽基指数行情",
    "description": "宽基指数行情 2.0（原 ETFstudio）双屏版：同一套视图代码按屏幕形状构建期分包——app.json 只声明一个构建目标 gt，platforms 写屏幕特征 st（r 圆屏 / s 方屏），形态几何由 zosLoader [pf] 注入的 shape 样式表推导（圆屏按 390×390 内切圆弦宽收窄，方屏沿用 390×450 版面）。附带 M1-M2 剪刀差快捷卡片（app-widget），数据由手机端取数后写入手表本地快照供卡片读取。全量接入 getText 多语言（34 种系统语言）与 Noto Sans / Zepp OS Number 设计字体。"
  },
  "permissions": [
    "data:os.device.info",
    "device:os.local_storage",
    "device:os.notification"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0.0",
      "target": "3.5.0",
      "minVersion": "3.0.0"
    }
  },
  "debug": false,
  "targets": {
    "gt": {
      "module": {
        "page": {
          "pages": [
            "page/home/index.page",
            "page/universe/index.page",
            "page/detail/index.page"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        },
        "app-widget": {
          "widgets": [
            {
              "path": "app-widget/index",
              "icon": "icon.png",
              "name": "M1-M2 剪刀差",
              "runtime": {
                "type": "js"
              }
            }
          ]
        }
      },
      "platforms": [
        {
          "st": "r"
        },
        {
          "st": "s"
        }
      ],
      "designWidth": 390
    }
  },
